{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "3.48.1",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "src/sw/index.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/panel.html"
  },
  "action": {
    "default_title": "__MSG_extName__"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "cookies",
    "scripting",
    "activeTab",
    "tabs",
    "alarms",
    "nativeMessaging",
    "debugger",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "key": "",
  "optional_host_permissions": [
    "*://*/*"
  ]
}
